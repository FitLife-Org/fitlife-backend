# =========================================================
# Spring
# =========================================================
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# =========================================================
# Database
# =========================================================
DB_URL=jdbc:mysql://localhost:3306/fitlife_db?useSSL=false&serverTimezone=Asia/Ho_Chi_Minh&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=root

DB_POOL_MIN_IDLE=2
DB_POOL_MAX_SIZE=10

# =========================================================
# JWT
# =========================================================
JWT_SECRET=replace_with_base64_secret_at_least_64_bytes
JWT_EXPIRATION_MS=1800000
REFRESH_TOKEN_EXPIRATION_DAYS=7

# =========================================================
# Frontend / CORS
# =========================================================
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_VERIFICATION_URL=http://localhost:5173/verify-email

# =========================================================
# Mail
# =========================================================
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@fitlife.local

# =========================================================
# Google
# =========================================================
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=

# =========================================================
# Cloudinary
# =========================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# =========================================================
# Gemini
# =========================================================
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# =========================================================
# Embedding / Qdrant
# =========================================================
AI_EMBEDDING_ENABLED=false
QDRANT_ENABLED=false
QDRANT_BASE_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=fitlife_knowledge

# =========================================================
# VNPay
# =========================================================
VNPAY_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:8080/api/v1/payments/vnpay/return
VNPAY_IPN_URL=http://localhost:8080/api/v1/payments/vnpay/ipn
VNPAY_FRONTEND_RESULT_URL=http://localhost:5173/member/payment/result

# =========================================================
# Swagger
# =========================================================
SWAGGER_ENABLED=true