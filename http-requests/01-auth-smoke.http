### ============================================================
### AUTH SMOKE TEST
### Có thể Run All
### Chạy 00-setup.http trước
### ============================================================


### 1. OpenAPI public
GET {{baseUrl}}/v3/api-docs
Accept: application/json

> {%
    client.test("OpenAPI is public", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
    });
%}


### 2. Protected API without token
GET {{baseUrl}}/users/me
Accept: application/json

> {%
    client.test("Missing token returns 401", function () {
        client.assert(response.status === 401, "Expected HTTP 401");
    });
%}


### 3. Protected API with invalid token
GET {{baseUrl}}/users/me
Authorization: Bearer invalid-token
Accept: application/json

> {%
    client.test("Invalid token returns 401", function () {
        client.assert(response.status === 401, "Expected HTTP 401");
    });
%}


### 4. Login Member
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "identifier": "{{seedMemberUsername}}",
  "password": "{{seedMemberPassword}}"
}

> {%
    client.test("Member login succeeds", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(response.body.data.accessToken, "Missing access token");
        client.assert(response.body.data.refreshToken, "Missing refresh token");
    });

    if (response.status === 200 && response.body.data) {
        client.global.set(
            "authSmokeAccessToken",
            response.body.data.accessToken
        );

        client.global.set(
            "authSmokeRefreshToken",
            response.body.data.refreshToken
        );
    }
%}


### 5. Login Member by email
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "identifier": "{{seedMemberEmail}}",
  "password": "{{seedMemberPassword}}"
}

> {%
    client.test("Email login succeeds", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
    });
%}


### 6. Login Admin
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "identifier": "{{seedAdminUsername}}",
  "password": "{{seedAdminPassword}}"
}

> {%
    client.test("Admin login succeeds", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
    });
%}


### 7. Refresh access token
POST {{baseUrl}}/auth/refresh-token
Content-Type: application/json
Accept: application/json

{
  "refreshToken": "{{authSmokeRefreshToken}}"
}

> {%
    client.test("Refresh succeeds", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(response.body.data.accessToken, "Missing new access token");
    });
%}


### 8. Wrong password
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "identifier": "{{seedMemberUsername}}",
  "password": "wrong-password"
}

> {%
    client.test("Wrong password returns 401", function () {
        client.assert(response.status === 401, "Expected HTTP 401");
    });
%}


### 9. Unknown account
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "identifier": "{{authUnknownUsername}}",
  "password": "{{seedMemberPassword}}"
}

> {%
    client.test("Unknown account returns 401", function () {
        client.assert(response.status === 401, "Expected HTTP 401");
    });
%}


### 10. Invalid refresh token
POST {{baseUrl}}/auth/refresh-token
Content-Type: application/json
Accept: application/json

{
  "refreshToken": "invalid-refresh-token"
}

> {%
    client.test("Invalid refresh token is rejected", function () {
        client.assert(
            response.status === 400 || response.status === 401,
            "Expected HTTP 400 or 401"
        );
    });
%}


### 11. Invalid verification token
GET {{baseUrl}}/auth/verify-email?token=invalid-token
Accept: application/json

> {%
    client.test("Invalid verification token is rejected", function () {
        client.assert(response.status === 400, "Expected HTTP 400");
    });
%}


### 12. Logout-all without token
POST {{baseUrl}}/auth/logout-all
Accept: application/json

> {%
    client.test("Logout all without token returns 401", function () {
        client.assert(response.status === 401, "Expected HTTP 401");
    });
%}


### 13. Invalid Google token
POST {{baseUrl}}/auth/google-login
Content-Type: application/json
Accept: application/json

{
  "idToken": "invalid-google-id-token"
}

> {%
    client.test("Invalid Google login is rejected", function () {
        client.assert(response.status >= 400, "Expected rejected request");
    });
%}