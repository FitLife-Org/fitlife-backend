### ============================================================
### ADMIN USER MANAGEMENT
### Cần chạy Login Admin trước
### ============================================================

@staffUsername = staff_{{runId}}
@staffEmail = staff_{{runId}}@fitlife.local
@staffPhone = 0901234501

@trainerUsername = trainer_{{runId}}
@trainerEmail = trainer_{{runId}}@fitlife.local
@trainerPhone = 0901234502


### 0. Login admin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "identifier": "{{seedAdminUsername}}",
  "password": "{{seedAdminPassword}}"
}

> {%
    client.test("Admin login succeeds", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
    });

    if (response.status === 200 && response.body.data) {
        client.global.set("adminToken", response.body.data.accessToken);
    }
%}


### 1. Admin profile
GET {{baseUrl}}/users/me
Authorization: Bearer {{adminToken}}
Accept: application/json

> {%
    client.test("Get admin profile succeeds", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
    });
%}


### 2. List users
GET {{baseUrl}}/admin/users?page=0&size=10
Authorization: Bearer {{adminToken}}
Accept: application/json

> {%
    client.test("Admin can list users", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(response.body.data.content, "Page content is missing");
    });
%}


### 3. Search users
GET {{baseUrl}}/admin/users?page=0&size=10&keyword=member
Authorization: Bearer {{adminToken}}
Accept: application/json


### 4. Filter role
GET {{baseUrl}}/admin/users?page=0&size=10&roleCode=ROLE_MEMBER
Authorization: Bearer {{adminToken}}
Accept: application/json


### 5. Filter status
GET {{baseUrl}}/admin/users?page=0&size=10&status=ACTIVE
Authorization: Bearer {{adminToken}}
Accept: application/json


### 6. Invalid status
GET {{baseUrl}}/admin/users?status=ABC
Authorization: Bearer {{adminToken}}
Accept: application/json

> {%
    client.test("Invalid enum returns 400", function () {
        client.assert(response.status === 400, "Expected HTTP 400");
    });
%}


### 7. Create Staff
POST {{baseUrl}}/admin/users
Authorization: Bearer {{adminToken}}
Content-Type: application/json
Accept: application/json

{
  "username": "{{staffUsername}}",
  "email": "{{staffEmail}}",
  "password": "12345678",
  "fullName": "FitLife Test Staff",
  "phone": "{{staffPhone}}",
  "roleCode": "ROLE_STAFF",
  "status": "ACTIVE"
}

> {%
    client.test("Create Staff succeeds", function () {
        client.assert(
            response.status === 200 || response.status === 201,
            "Expected HTTP 200 or 201"
        );

        client.assert(response.body.data.id, "Created Staff user ID is missing");
    });

    if (
        (response.status === 200 || response.status === 201) &&
        response.body.data
    ) {
        client.global.set(
            "createdStaffUserId",
            response.body.data.id
        );
    }
%}


### 8. Create Trainer user
POST {{baseUrl}}/admin/users
Authorization: Bearer {{adminToken}}
Content-Type: application/json
Accept: application/json

{
  "username": "{{trainerUsername}}",
  "email": "{{trainerEmail}}",
  "password": "12345678",
  "fullName": "FitLife Test Trainer",
  "phone": "{{trainerPhone}}",
  "roleCode": "ROLE_TRAINER",
  "status": "ACTIVE"
}

> {%
    client.test("Create Trainer user succeeds", function () {
        client.assert(
            response.status === 200 || response.status === 201,
            "Expected HTTP 200 or 201"
        );

        client.assert(response.body.data.id, "Created Trainer user ID is missing");
    });

    if (
        (response.status === 200 || response.status === 201) &&
        response.body.data
    ) {
        client.global.set(
            "createdTrainerUserId",
            response.body.data.id
        );
    }
%}


### 9. Internal MEMBER role should be rejected
POST {{baseUrl}}/admin/users
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "username": "internal_member_{{runId}}",
  "email": "internal_member_{{runId}}@fitlife.local",
  "password": "12345678",
  "fullName": "Internal Member Invalid",
  "phone": "0901234599",
  "roleCode": "ROLE_MEMBER",
  "status": "ACTIVE"
}

> {%
    client.test("Internal MEMBER creation is rejected", function () {
        client.assert(response.status === 400, "Expected HTTP 400");
    });
%}


### 10. Duplicate Staff email
POST {{baseUrl}}/admin/users
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "username": "duplicate_staff_{{runId}}",
  "email": "{{staffEmail}}",
  "password": "12345678",
  "fullName": "Duplicate Staff",
  "phone": "0901234598",
  "roleCode": "ROLE_STAFF",
  "status": "ACTIVE"
}

> {%
    client.test("Duplicate email is rejected", function () {
        client.assert(
            response.status === 400 || response.status === 409,
            "Expected HTTP 400 or 409"
        );
    });
%}


