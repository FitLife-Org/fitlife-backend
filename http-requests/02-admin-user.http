### 16. Lock created Staff
PATCH {{baseUrl}}/admin/users/{{createdStaffUserId}}/status
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "status": "LOCKED"
}

> {%
    client.test("Lock Staff succeeds", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
    });
%}


### 17. Locked Staff cannot login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "identifier": "{{staffUsername}}",
  "password": "12345678"
}

> {%
    client.test("Locked Staff cannot login", function () {
        client.assert(
            response.status === 401 || response.status === 403,
            "Expected HTTP 401 or 403"
        );
    });
%}


### 18. Activate Staff again
PATCH {{baseUrl}}/admin/users/{{createdStaffUserId}}/status
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "status": "ACTIVE"
}


