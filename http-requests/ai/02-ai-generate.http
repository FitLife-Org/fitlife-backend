### ============================================================
### 1. BODY ANALYSIS
### ============================================================

# @timeout 120000
POST {{baseUrl}}/ai/suggestions/body-analysis
Authorization: Bearer {{memberToken}}
Content-Type: application/json
Accept: application/json

{
  "preferredLanguage": "vi",
  "userNote": "Phân tích ngắn gọn và đưa ra khuyến nghị thực tế."
}

> {%
    client.test("Body analysis created", function () {
        client.assert(
            response.status === 200,
            "Expected HTTP 200"
        );

        client.assert(
            response.body.data != null,
            "Response data is missing"
        );

        client.assert(
            response.body.data.id != null,
            "Suggestion ID is missing"
        );

        client.assert(
            response.body.data.suggestionType
            === "BODY_ANALYSIS",
            "Expected BODY_ANALYSIS"
        );

        client.assert(
            response.body.data.status
            === "SUCCESS",
            "Expected SUCCESS"
        );
    });

    if (response.status === 200
        && response.body.data?.id != null) {
        client.global.set(
            "bodyAnalysisSuggestionId",
            response.body.data.id
        );
    }
%}

### ============================================================
### 2. BODY ANALYSIS DETAIL
### ============================================================

GET {{baseUrl}}/ai/suggestions/{{bodyAnalysisSuggestionId}}
Authorization: Bearer {{memberToken}}
Accept: application/json

> {%
    client.test("Get body analysis detail successfully", function () {
        client.assert(
            response.status === 200,
            "Expected HTTP 200"
        );

        client.assert(
            response.body.data.id != null,
            "Suggestion ID is missing"
        );

        client.assert(
            response.body.data.suggestionType
            === "BODY_ANALYSIS",
            "Expected BODY_ANALYSIS"
        );

        client.assert(
            response.body.data.status
            === "SUCCESS",
            "Expected SUCCESS status"
        );

        client.assert(
            Array.isArray(
                response.body.data.items
            ),
            "items must be an array"
        );
    });
%}

### ============================================================
### 3. GENERATE WORKOUT PLAN
### ============================================================

# @timeout 120000
POST {{baseUrl}}/ai/suggestions/workout-plan
Authorization: Bearer {{memberToken}}
Content-Type: application/json
Accept: application/json

{
  "goal": "LOSE_WEIGHT",
  "experienceLevel": "BEGINNER",
  "activityLevel": "MODERATE",
  "workoutDaysPerWeek": 3,
  "workoutDurationMinutes": 45,
  "preferredLanguage": "vi",
  "userNote": "Ưu tiên bài tập an toàn, đơn giản và sử dụng thiết bị phổ biến."
}

> {%
    client.test("Generate workout plan successfully", function () {
        client.assert(
            response.status === 200,
            "Expected HTTP 200"
        );

        client.assert(
            response.body.data != null,
            "Response data is missing"
        );

        client.assert(
            response.body.data.id != null,
            "Suggestion ID is missing"
        );

        client.assert(
            response.body.data.suggestionType
            === "WORKOUT_PLAN",
            "Expected WORKOUT_PLAN"
        );

        client.assert(
            response.body.data.status
            === "SUCCESS",
            "Expected SUCCESS"
        );

        client.assert(
            Array.isArray(
                response.body.data.items
            ),
            "items must be an array"
        );
    });

    if (response.status === 200
        && response.body.data?.id != null) {
        client.global.set(
            "workoutSuggestionId",
            response.body.data.id
        );
    }
%}

