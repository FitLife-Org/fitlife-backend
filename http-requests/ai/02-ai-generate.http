### ============================================================
### 1. BODY ANALYSIS
### ============================================================

POST {{baseUrl}}/ai/suggestions/body-analysis
Authorization: Bearer {{memberToken}}
Content-Type: application/json
Accept: application/json

{
  "preferredLanguage": "vi",
  "userNote": "Phân tích ngắn gọn và đưa ra khuyến nghị thực tế."
}

> {%
    client.test("Body analysis created", function () {
        client.assert(
            response.status === 200,
            "Expected HTTP 200"
        );

        client.assert(
            response.body.data.id,
            "Suggestion ID is missing"
        );
    });

    client.global.set(
        "bodyAnalysisSuggestionId",
        response.body.data.id
    );
%}

### ============================================================
### 2. WORKOUT PLAN
### ============================================================

POST {{baseUrl}}/ai/suggestions/workout-plan
Authorization: Bearer {{memberToken}}
Content-Type: application/json
Accept: application/json

{
  "goal": "LOSE_WEIGHT",
  "experienceLevel": "BEGINNER",
  "activityLevel": "MODERATE",
  "workoutDaysPerWeek": 3,
  "workoutDurationMinutes": 45,
  "preferredLanguage": "vi",
  "userNote": "Ưu tiên máy tập và bài tập đơn giản."
}

> {%
    client.test("Workout plan created", function () {
        client.assert(response.status === 200);
        client.assert(response.body.data.id);
    });

    client.global.set(
        "workoutSuggestionId",
        response.body.data.id
    );
%}