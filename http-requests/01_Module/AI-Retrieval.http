{
  "query": "Chế độ ăn giảm mỡ an toàn và đủ protein",
  "category": "NUTRITION",
  "goal": "LOSE_WEIGHT",
  "experienceLevel": "BEGINNER",
  "language": "vi",
  "limit": 5,
