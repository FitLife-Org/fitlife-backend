### =====================================================
### AI RETRIEVAL - QDRANT SEARCH TEST
### =====================================================

@baseUrl = http://localhost:8080/api/v1

#########################################################
### 1. SEARCH WORKOUT KNOWLEDGE
#########################################################

POST {{baseUrl}}/admin/ai/knowledge/search-test
Authorization: Bearer {{adminToken}}
Content-Type: application/json
Accept: application/json

{
  "query": "Lịch tập giảm cân an toàn cho người mới",
  "category": "WORKOUT",
  "goal": "LOSE_WEIGHT",
  "experienceLevel": "BEGINNER",
  "language": "vi",
  "limit": 5,
  "scoreThreshold": 0.2
}

> {%
    client.test("Search-test trả HTTP 200", function () {
        client.assert(
            response.status === 200,
            "Expected HTTP 200"
        );
    });

    client.test("Response có metadata", function () {
        client.assert(
            response.body.data,
            "Missing response data"
        );

        client.assert(
            response.body.data.collection,
            "Missing Qdrant collection"
        );

        client.assert(
            Array.isArray(
                response.body.data.results
            ),
            "Results must be an array"
        );
    });
%}

###

#########################################################
### 2. SEARCH NUTRITION KNOWLEDGE
#########################################################

POST {{baseUrl}}/admin/ai/knowledge/search-test
Authorization: Bearer {{adminToken}}
Content-Type: application/json
