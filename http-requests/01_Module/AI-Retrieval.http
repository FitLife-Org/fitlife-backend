#########################################################
### 4. HIGH SCORE THRESHOLD
### Có thể trả results rỗng nhưng vẫn phải HTTP 200
#########################################################

POST {{baseUrl}}/admin/ai/knowledge/search-test
Authorization: Bearer {{adminToken}}
Content-Type: application/json
Accept: application/json

{
  "query": "Lịch tập giảm cân",
  "category": "WORKOUT",
  "goal": "LOSE_WEIGHT",
  "experienceLevel": "BEGINNER",
  "language": "vi",
  "limit": 5,
  "scoreThreshold": 0.95
}

