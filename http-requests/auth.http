### ============================================================
### FITLIFE AUTH API TEST
### Base URL includes context path: /api/v1
### ============================================================

@baseUrl = http://localhost:8080/api/v1

### Thay token lấy từ email khi test verify
@verificationToken = XYU1pz6w3fqxA-vmItE5iAO2rbzWRMYbR7XaxY0Kbl0


### ============================================================
### 1. REGISTER
### ============================================================

### 1.1 Register Member 03 - success
POST {{baseUrl}}/auth/register
Content-Type: application/json
Accept: application/json

{
  "username": "member04",
  "email": "member04@gmail.com",
  "password": "123456",
  "fullName": "Member 04",
  "phone": "0101010104"
}


### 1.2 Register duplicate username - should fail
POST {{baseUrl}}/auth/register
Content-Type: application/json
Accept: application/json

{
  "username": "member03",
  "email": "member03_new@gmail.com",
  "password": "123456",
  "fullName": "Duplicate Username",
  "phone": "0101010199"
}


### 1.3 Register duplicate email - should fail
POST {{baseUrl}}/auth/register
Content-Type: application/json
Accept: application/json

{
  "username": "member03_duplicate_email",
  "email": "member03@gmail.com",
  "password": "123456",
  "fullName": "Duplicate Email",
  "phone": "0101010198"
}


### 1.4 Register duplicate phone - should fail
POST {{baseUrl}}/auth/register
Content-Type: application/json
Accept: application/json

{
  "username": "member03_duplicate_phone",
  "email": "member03_phone@gmail.com",
  "password": "123456",
  "fullName": "Duplicate Phone",
  "phone": "0101010103"
}


### 1.5 Register validation failed - should fail
POST {{baseUrl}}/auth/register
Content-Type: application/json
Accept: application/json

{
  "username": "",
  "email": "",
  "password": "123",
  "fullName": "",
  "phone": ""
}


### ============================================================
### 2. EMAIL VERIFICATION
### ============================================================

### 2.1 Login before verifying email - should fail EMAIL_NOT_VERIFIED
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "identifier": "member04",
  "password": "123456"
}


### 2.2 Verify email - success
### Copy raw token from the Mailtrap verification link
GET {{baseUrl}}/auth/verify-email?token={{verificationToken}}
Accept: application/json


### 2.3 Verify with invalid token - should fail
GET {{baseUrl}}/auth/verify-email?token=invalid-token
Accept: application/json


### 2.4 Resend verification email - success
POST {{baseUrl}}/auth/resend-verification-email
Content-Type: application/json
Accept: application/json

{
  "email": "member03@gmail.com"
}


### 2.5 Resend verification for unknown email
### Response should still be success to avoid email enumeration
POST {{baseUrl}}/auth/resend-verification-email
Content-Type: application/json
Accept: application/json

{
  "email": "unknown_user@gmail.com"
}


### ============================================================
### 3. LOGIN
### ============================================================

### 3.1 Login Member 03 by username - success
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "identifier": "member03",
  "password": "123456"
}

> {%
    client.test("Member login successful", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(response.body.data.accessToken, "Access token is missing");
        client.assert(response.body.data.refreshToken, "Refresh token is missing");
    });

    client.global.set(
        "accessToken",
        response.body.data.accessToken
    );

    client.global.set(
        "refreshToken",
        response.body.data.refreshToken
    );
%}


### 3.2 Login Member 03 by email - success
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "identifier": "member03@gmail.com",
  "password": "123456"
}

> {%
    client.global.set(
        "accessToken",
        response.body.data.accessToken
    );

    client.global.set(
        "refreshToken",
        response.body.data.refreshToken
    );
%}


### 3.3 Admin login - success
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "identifier": "admin",
  "password": "123456"
}

> {%
    client.test("Admin login successful", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(response.body.data.accessToken, "Admin access token is missing");
    });

    client.global.set(
        "adminToken",
        response.body.data.accessToken
    );

    client.global.set(
        "adminRefreshToken",
        response.body.data.refreshToken
    );
%}

### 3.4 Login with wrong password - should fail
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "identifier": "member03@gmail.com",
  "password": "wrongpassword"
}


### 3.5 Login with unknown identifier - should fail
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "identifier": "unknown_member",
  "password": "123456"
}


### ============================================================
### 4. REFRESH TOKEN
### ============================================================

### 4.1 Create new access token - success
POST {{baseUrl}}/auth/refresh-token
Content-Type: application/json
Accept: application/json

{
  "refreshToken": "{{refreshToken}}"
}

> {%
    client.test("Refresh token successful", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(response.body.data.accessToken, "New access token is missing");
    });

    client.global.set(
        "accessToken",
        response.body.data.accessToken
    );
%}


### 4.2 Refresh using invalid token - should fail
POST {{baseUrl}}/auth/refresh-token
Content-Type: application/json
Accept: application/json

{
  "refreshToken": "invalid-refresh-token"
}


### ============================================================
### 5. LOGOUT CURRENT DEVICE
### ============================================================

### 5.1 Logout current device - success
POST {{baseUrl}}/auth/logout
Content-Type: application/json
Accept: application/json

{
  "refreshToken": "{{refreshToken}}"
}


### 5.2 Use revoked refresh token - should fail
POST {{baseUrl}}/auth/refresh-token
Content-Type: application/json
Accept: application/json

{
  "refreshToken": "{{refreshToken}}"
}


### 5.3 Logout same token again - should still succeed
### Logout is idempotent
POST {{baseUrl}}/auth/logout
Content-Type: application/json
Accept: application/json

{
  "refreshToken": "{{refreshToken}}"
}


### ============================================================
### 6. LOGOUT ALL DEVICES
### ============================================================

### 6.1 Login again to obtain new tokens
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "identifier": "member03",
  "password": "123456"
}

> {%
    client.global.set(
        "accessToken",
        response.body.data.accessToken
    );

    client.global.set(
        "refreshToken",
        response.body.data.refreshToken
    );
%}


### 6.2 Login second time to simulate another device
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "identifier": "member03",
  "password": "123456"
}

> {%
    client.global.set(
        "secondAccessToken",
        response.body.data.accessToken
    );

    client.global.set(
        "secondRefreshToken",
        response.body.data.refreshToken
    );
%}


### 6.3 Logout all devices - success
POST {{baseUrl}}/auth/logout-all
Authorization: Bearer {{accessToken}}
Accept: application/json


### 6.4 First refresh token should now be revoked
POST {{baseUrl}}/auth/refresh-token
Content-Type: application/json
Accept: application/json

{
  "refreshToken": "{{refreshToken}}"
}


### 6.5 Second refresh token should now be revoked
POST {{baseUrl}}/auth/refresh-token
Content-Type: application/json
Accept: application/json

{
  "refreshToken": "{{secondRefreshToken}}"
}


### 6.6 Logout all without access token - should fail 401
POST {{baseUrl}}/auth/logout-all
Accept: application/json


### ============================================================
### 7. PASSWORD RESET
### ============================================================

### 7.1 Forgot password - send OTP
POST {{baseUrl}}/auth/forgot-password
Content-Type: application/json
Accept: application/json

{
  "email": "member03@gmail.com"
}


### 7.2 Reset password using OTP
### Replace OTP copied from Mailtrap
POST {{baseUrl}}/auth/reset-password
Content-Type: application/json
Accept: application/json

{
  "email": "member03@gmail.com",
  "otp": "123456",
  "newPassword": "newPassword123",
  "confirmPassword": "newPassword123"
}


### ============================================================
### 8. GOOGLE LOGIN
### ============================================================

### 8.1 Google login
### Replace with a valid Google ID token
POST {{baseUrl}}/auth/google-login
Content-Type: application/json
Accept: application/json

{
  "idToken": "your-google-id-token"
}