### ============================================================
### FITLIFE GLOBAL TEST SETUP
### Chạy file này trước các module khác
### Environment: local
### ============================================================

### 1. OpenAPI health check
GET {{baseUrl}}/v3/api-docs
Accept: application/json

> {%
    client.test("Backend is running", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
    });
%}


### 2. Login Member
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "identifier": "{{seedMemberUsername}}",
  "password": "{{seedMemberPassword}}"
}

> {%
    client.test("Member login succeeds", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(response.body.data, "Missing response data");
        client.assert(response.body.data.accessToken, "Missing access token");
    });

    if (response.status === 200 && response.body.data) {
        client.global.set(
            "memberToken",
            response.body.data.accessToken
        );

        client.global.set(
            "memberRefreshToken",
            response.body.data.refreshToken
        );
    }
%}


### 3. Login Admin
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "identifier": "{{seedAdminUsername}}",
  "password": "{{seedAdminPassword}}"
}

> {%
    client.test("Admin login succeeds", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(response.body.data.accessToken, "Missing admin token");
    });

    if (response.status === 200 && response.body.data) {
        client.global.set(
            "adminToken",
            response.body.data.accessToken
        );

        client.global.set(
            "adminRefreshToken",
            response.body.data.refreshToken
        );
    }
%}


