### ============================================================
### CURRENT USER + MEMBER PROFILE
### ============================================================


### 0. Login seeded member
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "identifier": "{{seedMemberUsername}}",
  "password": "{{seedMemberPassword}}"
}

> {%
    client.test("Member login succeeds", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
    });

    if (response.status === 200 && response.body.data) {
        client.global.set("memberToken", response.body.data.accessToken);
    }
%}


### 1. Get current user
GET {{baseUrl}}/users/me
Authorization: Bearer {{memberToken}}
Accept: application/json

> {%
    client.test("Get current user succeeds", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
    });
%}


### 2. Get current member profile
GET {{baseUrl}}/members/me
Authorization: Bearer {{memberToken}}
Accept: application/json

> {%
    client.test("Get current member profile succeeds", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
    });
%}


### 3. Update current member profile
PUT {{baseUrl}}/members/me
Authorization: Bearer {{memberToken}}
Content-Type: application/json
Accept: application/json

{
  "fullName": "Member Profile Updated",
  "phone": "0900000005",
  "avatarUrl": "https://example.com/avatar.png",
  "gender": "MALE",
  "dateOfBirth": "2002-05-20",
  "address": "Hà Nội",
  "emergencyContactName": "Emergency Contact",
  "emergencyContactPhone": "0922222222",
  "fitnessGoal": "BODY_RECOMPOSITION",
  "healthNote": "Muốn giảm mỡ và tăng cơ"
}

> {%
    client.test("Update member profile succeeds", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
    });
%}


### 4. Invalid date
PUT {{baseUrl}}/members/me
Authorization: Bearer {{memberToken}}
Content-Type: application/json

{
  "dateOfBirth": "2030-01-01"
}

> {%
    client.test("Future birth date is rejected", function () {
        client.assert(response.status === 400, "Expected HTTP 400");
    });
%}


### 5. Get profile without token
GET {{baseUrl}}/members/me

> {%
    client.test("Member profile without token returns 401", function () {
        client.assert(response.status === 401, "Expected HTTP 401");
    });
%}


### ============================================================
### CHANGE PASSWORD
### Dùng Staff test riêng để không làm hỏng seeded Member
### ============================================================

### 6. Login seeded Staff
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "identifier": "{{seedStaffUsername}}",
  "password": "{{seedStaffPassword}}"
}

> {%
    client.test("Staff login succeeds", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
    });

    if (response.status === 200 && response.body.data) {
        client.global.set("staffToken", response.body.data.accessToken);
    }
%}


### 7. Change Staff password
PUT {{baseUrl}}/users/me/change-password
Authorization: Bearer {{staffToken}}
Content-Type: application/json

{
  "currentPassword": "{{seedStaffPassword}}",
  "newPassword": "StaffPassword123",
  "confirmPassword": "StaffPassword123"
}

> {%
    client.test("Change password succeeds", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
    });
%}


### 8. Login using old password should fail
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "identifier": "{{seedStaffUsername}}",
  "password": "{{seedStaffPassword}}"
}

> {%
    client.test("Old password is rejected", function () {
        client.assert(response.status === 401, "Expected HTTP 401");
    });
%}


### 9. Login using new password
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "identifier": "{{seedStaffUsername}}",
  "password": "StaffPassword123"
}

> {%
    client.test("New password succeeds", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
    });

    if (response.status === 200 && response.body.data) {
        client.global.set("staffToken", response.body.data.accessToken);
    }
%}


### 10. Wrong current password
PUT {{baseUrl}}/users/me/change-password
Authorization: Bearer {{staffToken}}
Content-Type: application/json

{
  "currentPassword": "wrong-password",
  "newPassword": "AnotherPassword123",
  "confirmPassword": "AnotherPassword123"
}

> {%
    client.test("Wrong current password is rejected", function () {
        client.assert(response.status === 400, "Expected HTTP 400");
    });
%}


### 11. Confirmation mismatch
PUT {{baseUrl}}/users/me/change-password
Authorization: Bearer {{staffToken}}
Content-Type: application/json

{
  "currentPassword": "StaffPassword123",
  "newPassword": "AnotherPassword123",
  "confirmPassword": "DifferentPassword123"
}

> {%
    client.test("Password confirmation mismatch is rejected", function () {
        client.assert(response.status === 400, "Expected HTTP 400");
    });
%}


### 12. New password same as current
PUT {{baseUrl}}/users/me/change-password
Authorization: Bearer {{staffToken}}
Content-Type: application/json

{
  "currentPassword": "StaffPassword123",
  "newPassword": "StaffPassword123",
  "confirmPassword": "StaffPassword123"
}

> {%
    client.test("Reusing current password is rejected", function () {
        client.assert(response.status === 400, "Expected HTTP 400");
    });
%}


### 13. Restore Staff password for repeatable test
PUT {{baseUrl}}/users/me/change-password
Authorization: Bearer {{staffToken}}
Content-Type: application/json

{
  "currentPassword": "StaffPassword123",
  "newPassword": "{{seedStaffPassword}}",
  "confirmPassword": "{{seedStaffPassword}}"
}