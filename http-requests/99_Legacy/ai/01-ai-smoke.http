### ============================================================
### FITLIFE AI - SMOKE TEST
### ============================================================

@baseUrl = http://localhost:8080/api/v1


### 1. Usage today
GET {{baseUrl}}/ai/suggestions/usage/today
Authorization: Bearer {{memberToken}}
Accept: application/json

> {%
    client.test("Usage today returns 200", function () {
        client.assert(response.status === 200);
    });
%}


### 2. My AI history
GET {{baseUrl}}/ai/suggestions/my?page=0&size=10
Authorization: Bearer {{memberToken}}
Accept: application/json

> {%
    client.test("AI history returns 200", function () {
        client.assert(response.status === 200);
        client.assert(
            Array.isArray(response.body.data.content),
            "History content must be an array"
        );
    });
%}


### 3. Filter history
GET {{baseUrl}}/ai/suggestions/my/filter?status=SUCCESS&page=0&size=10
Authorization: Bearer {{memberToken}}
Accept: application/json

> {%
    client.test("Filtered history returns 200", function () {
        client.assert(response.status === 200);
    });
%}


### 4. Protected API without token
GET {{baseUrl}}/ai/suggestions/usage/today
Accept: application/json

> {%
    client.test("Missing token returns 401", function () {
        client.assert(response.status === 401);
    });
%}


### 5. Member AI API with admin token
GET {{baseUrl}}/ai/suggestions/usage/today
Authorization: Bearer {{adminToken}}
Accept: application/json

> {%
    client.test("Admin cannot use member AI API", function () {
        client.assert(
            response.status === 403 ||
            response.status === 404
        );
    });
%}