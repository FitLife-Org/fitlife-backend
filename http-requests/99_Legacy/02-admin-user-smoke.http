### ============================================================
### ADMIN USER SMOKE TEST
### Environment: local
### Có thể Run All
### ============================================================


### 0. Login Admin
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "identifier": "{{seedAdminUsername}}",
  "password": "{{seedAdminPassword}}"
}

> {%
    client.test("Admin login succeeds", function () {
        client.assert(
            response.status === 200,
            "Expected HTTP 200"
        );

        client.assert(
            response.body.data.accessToken,
            "Missing admin access token"
        );
    });

    if (
        response.status === 200 &&
        response.body.data
    ) {
        client.global.set(
            "adminToken",
            response.body.data.accessToken
        );
    }
%}


### 1. Get Admin profile
GET {{baseUrl}}/users/me
Authorization: Bearer {{adminToken}}
Accept: application/json

> {%
    client.test("Get Admin profile succeeds", function () {
        client.assert(
            response.status === 200,
            "Expected HTTP 200"
        );

        client.assert(
            response.body.data.id,
            "Missing Admin ID"
        );
    });

    if (
        response.status === 200 &&
        response.body.data
    ) {
        client.global.set(
            "currentAdminUserId",
            response.body.data.id
        );
    }
%}


### 2. Get user list
GET {{baseUrl}}/admin/users?page=0&size=10
Authorization: Bearer {{adminToken}}
Accept: application/json

> {%
    client.test("Get user list succeeds", function () {
        client.assert(
            response.status === 200,
            "Expected HTTP 200"
        );

        client.assert(
            Array.isArray(response.body.data.content),
            "Page content must be an array"
        );

        client.assert(
            response.body.data.page === 0,
            "Expected page 0"
        );
    });
%}


