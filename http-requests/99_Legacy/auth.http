### ============================================================
### 3. LOGIN
### LoginRequest dùng field "identifier"
### Có thể nhập email hoặc username
### ============================================================

### AUTH-04 — Login bằng email
POST {{baseUrl}}/auth/login
Content-Type: {{contentType}}

{
  "identifier": "{{testEmail}}",
  "password": "{{testPassword}}"
}

> {%
    client.test("Login bằng email thành công", function () {
        client.assert(
            response.status === 200,
            "Expected 200, actual: " + response.status
        );
    });

    client.test("Response có accessToken", function () {
        client.assert(
            response.body.result !== undefined,
            "Response không có result"
        );

        client.assert(
            response.body.result.accessToken !== undefined,
            "Response không có accessToken"
        );
    });

    if (
        response.body &&
        response.body.result &&
        response.body.result.accessToken
    ) {
        client.global.set(
            "memberToken",
            response.body.result.accessToken
        );
    }

    if (
        response.body &&
        response.body.result &&
        response.body.result.refreshToken
    ) {
        client.global.set(
            "refreshToken",
            response.body.result.refreshToken
        );
    }
%}


### AUTH-04-B — Login bằng username
POST {{baseUrl}}/auth/login
Content-Type: {{contentType}}

{
  "identifier": "{{testUsername}}",
  "password": "{{testPassword}}"
}

> {%
    if (
        response.body &&
        response.body.result &&
        response.body.result.accessToken
    ) {
        client.global.set(
            "memberToken",
            response.body.result.accessToken
        );
    }

    if (
        response.body &&
        response.body.result &&
        response.body.result.refreshToken
    ) {
        client.global.set(
            "refreshToken",
            response.body.result.refreshToken
        );
    }
%}


