### ============================================================
### 4. GET CURRENT USER
### ============================================================

### USER-01 — Lấy thông tin tài khoản hiện tại
GET {{baseUrl}}/users/me
Authorization: Bearer {{memberToken}}
Accept: application/json

> {%
    client.test("Get current user thành công", function () {
        client.assert(
            response.status === 200,
            "Expected 200, actual: " + response.status
        );
    });

    client.test("Response có thông tin user", function () {
        client.assert(
            response.body.result !== undefined,
            "Response không có result"
        );
    });
%}


### USER-01-N01 — Không có token
GET {{baseUrl}}/users/me
Accept: application/json


### USER-01-N02 — Token sai
GET {{baseUrl}}/users/me
Authorization: Bearer invalid-token
Accept: application/json


### USER-01-N03 — Token không có Bearer
GET {{baseUrl}}/users/me
Authorization: {{memberToken}}
Accept: application/json


### ============================================================
### 5. REFRESH TOKEN
### ============================================================

### AUTH-05 — Refresh token thành công
POST {{baseUrl}}/auth/refresh-token
Content-Type: {{contentType}}

{
  "refreshToken": "{{refreshToken}}"
}

> {%
    client.test("Refresh token thành công", function () {
        client.assert(
            response.status === 200,
            "Expected 200, actual: " + response.status
        );
    });

    if (
        response.body &&
        response.body.result &&
        response.body.result.accessToken
    ) {
        client.global.set(
            "memberToken",
            response.body.result.accessToken
        );
    }

    if (
        response.body &&
        response.body.result &&
        response.body.result.refreshToken
    ) {
        client.global.set(
            "refreshToken",
            response.body.result.refreshToken
        );
    }
%}


### AUTH-05-N01 — Refresh token sai
POST {{baseUrl}}/auth/refresh-token
Content-Type: {{contentType}}

{
  "refreshToken": "invalid-refresh-token"
}


### AUTH-05-N02 — Refresh token rỗng
POST {{baseUrl}}/auth/refresh-token
Content-Type: {{contentType}}

{
  "refreshToken": ""
}


