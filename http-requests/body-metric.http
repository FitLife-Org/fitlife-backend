### Create body metric for member
POST {{baseUrl}}/body-metrics
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "weightKg": 72.5,
  "heightCm": 170.0,
  "bodyFatPercent": 22.5,
  "muscleMassKg": 30.2,
  "note": "Lần đo đầu tiên, mục tiêu giảm mỡ nhẹ",
  "recordedAt": "2026-07-01T09:00:00"
}


### =========================================================
### 2. MEMBER - Get my body metrics with pagination
### GET /api/v1/body-metrics/my?page=0&size=10
### Role: MEMBER
### =========================================================

GET {{baseUrl}}/body-metrics/my?page=0&size=10
Authorization: Bearer {{accessToken}}


### =========================================================
### 3. MEMBER - Get my body metric detail
### GET /api/v1/body-metrics/{id}
### Role: MEMBER
### =========================================================

GET {{baseUrl}}/body-metrics/{{bodyMetricId}}
Authorization: Bearer {{accessToken}}


### =========================================================
### 4. MEMBER - Get latest my body metric
### GET /api/v1/body-metrics/my/latest
### Role: MEMBER
### =========================================================

GET {{baseUrl}}/body-metrics/my/latest
Authorization: Bearer {{accessToken}}


### =========================================================
### 5. MEMBER - Get my body metric history by time range
### GET /api/v1/body-metrics/my/history
### Role: MEMBER
### =========================================================

GET {{baseUrl}}/body-metrics/my/history?from=2026-07-01T00:00:00&to=2026-07-31T23:59:59
Authorization: Bearer {{accessToken}}


### =========================================================
### 6. MEMBER - Update my body metric
### PUT /api/v1/body-metrics/{id}
### Role: MEMBER
### =========================================================

PUT {{baseUrl}}/body-metrics/{{bodyMetricId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "weightKg": 71.8,
  "heightCm": 170.0,
  "bodyFatPercent": 21.8,
  "muscleMassKg": 30.6,
  "note": "Cập nhật sau một tuần tập luyện",
  "recordedAt": "2026-07-08T09:00:00"
}


### =========================================================
### 7. MEMBER - Delete my body metric
### DELETE /api/v1/body-metrics/{id}
### Role: MEMBER
### =========================================================

DELETE {{baseUrl}}/body-metrics/{{bodyMetricId}}
Authorization: Bearer {{accessToken}}


### =========================================================
### 8. ADMIN/STAFF - Create body metric for member
### POST /api/v1/admin/members/{memberId}/body-metrics
### Role: ADMIN, STAFF
### =========================================================

POST {{baseUrl}}/admin/members/{{memberId}}/body-metrics
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "weightKg": 75.0,
  "heightCm": 172.0,
  "bodyFatPercent": 24.0,
  "muscleMassKg": 31.0,
  "note": "Staff nhập chỉ số cho member tại quầy",
  "recordedAt": "2026-07-01T10:00:00"
}


### =========================================================
### 9. ADMIN/STAFF - Get body metrics by member
### GET /api/v1/admin/members/{memberId}/body-metrics
### Role: ADMIN, STAFF
### =========================================================

GET {{baseUrl}}/admin/members/{{memberId}}/body-metrics?page=0&size=10
Authorization: Bearer {{accessToken}}


### =========================================================
### 10. ADMIN/STAFF - Get latest body metric by member
### GET /api/v1/admin/members/{memberId}/body-metrics/latest
### Role: ADMIN, STAFF
### =========================================================

GET {{baseUrl}}/admin/members/{{memberId}}/body-metrics/latest
Authorization: Bearer {{accessToken}}


